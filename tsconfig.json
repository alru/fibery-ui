{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    // Pure modules import each other as "./x.ts", so Node runs them in tests as they are; emitted code gets ".js".
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"]
}
